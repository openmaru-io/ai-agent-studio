# AAS compose 설정. 이 파일을 .env 로 복사해 채운다(.env 는 git 에 올리지 않는다).
#   cp .env.example .env
# 빠른 시작(docker-compose.yml)은 아래 「필수」 칸만 채우면 된다. 비어 있으면 docker compose up 이 이유를 내고 멈춘다.

# --- 필수 ---------------------------------------------------------------
# 첫 관리자. AAS 에 계정이 하나도 없을 때만 이 값으로 만든다. 그 뒤 화면에서 비밀번호를 바꿔도 다시 덮지 않는다.
AAS_ADMIN_EMAIL=
# 10자 이상
AAS_ADMIN_PASSWORD=
# 읽기 사이드카와 서버가 나눠 가지는 토큰(16자 이상). 예: openssl rand -hex 24
AAS_SIDECAR_TOKEN=
# Hermes 대시보드 비밀번호. AAS 서버만 쓴다(사람이 입력할 일은 없다). 예: openssl rand -hex 16
HERMES_DASHBOARD_PASSWORD=
# LLM: OpenAI 호환 주소 하나를 Hermes 가 쓴다. 기본 주소에 /v1 까지 적는다.
#   이 컴퓨터의 Ollama      HERMES_LLM_BASE_URL=http://host.docker.internal:11434/v1   HERMES_LLM_MODEL=llama3.1:8b    (키 없음)
#                          Hermes 는 문맥 64K 토큰 이상이 필요하다: Ollama 를 OLLAMA_CONTEXT_LENGTH=65536 으로 띄우고 그만큼 되는 모델을 쓴다(qwen3 계열은 40,960 이라 안 된다)
#   OpenAI                  HERMES_LLM_BASE_URL=https://api.openai.com/v1              HERMES_LLM_MODEL=gpt-4.1-mini   HERMES_LLM_API_KEY=<OpenAI 키>
#   LiteLLM 등 다른 프록시  그 프록시의 /v1 주소와 모델 이름
# 처음 띄울 때 Hermes 의 기본 프로파일 비밀값에도 들어간다. 나중에 바꾸려면 AAS 의 프로파일 비밀값 화면에서 고친다.
# AAS 의 모델 화면과 AI 보조(태그·요약·슬로건·카드 나누기)도 같은 주소·모델·키를 쓴다(주소에 /models·/chat/completions 를 붙인다).
HERMES_LLM_BASE_URL=
HERMES_LLM_MODEL=
HERMES_LLM_API_KEY=

# --- 선택 ---------------------------------------------------------------
# 콘솔을 여는 주소와 포트. 기본은 이 컴퓨터에서만(127.0.0.1:17900).
AAS_BIND=127.0.0.1
AAS_PORT=17900
# 접속을 허용할 Host(쉼표로 구분). 비워 두면 localhost 와 127.0.0.1 에 위 포트를 붙인 것만 허용한다.
# 다른 이름·주소로 접속하려면 전체 목록을 적는다. 예: localhost:17900,127.0.0.1:17900,aas.local:17900
AAS_ALLOWED_HOSTS=
# 화면이 웹소켓 하나로 실시간 갱신을 받는다(기본 on). 앞에 다른 프록시를 두면 Upgrade·Connection 헤더를 넘겨야 한다. off 면 HTTP 폴링·SSE 로 받는다
AAS_WS=on
# 음성 입력. 비우면 끔. 적으면 HERMES_LLM_BASE_URL 의 /audio/transcriptions 를 이 모델 이름으로 부른다(예: LiteLLM 별칭 cogentai-stt).
# whisper-large-v3-turbo·whisper-large-v3 는 쓰지 않는다 — Hermes 가 Groq 모델 이름으로 보고 whisper-1 로 바꿔 부른다. vLLM 에 바로 붙이면 --served-model-name 에 다른 이름을 더한다
AAS_STT_MODEL=
# 답 읽어 주기. 둘 다 비우면 끔. AAS_TTS_MODEL 은 HERMES_LLM_BASE_URL 의 /audio/speech 를 부를 모델 이름(예: LiteLLM 별칭 cogentai-tts).
# AAS_TTS_VOICES 는 엔진에 등록된 목소리 목록 JSON 한 줄. 첫 목소리가 기본이다. 예:
# AAS_TTS_VOICES='[{"id":"ko-female-calm-a","name":{"ko":"차분한 여성","en":"Calm female"},"gender":"female","sample":"안녕하세요."}]'
AAS_TTS_MODEL=
AAS_TTS_VOICES=
# AAS 앞에 https 리버스 프록시를 두면, 프록시가 보낸 X-Forwarded-Proto: https 를 믿을 연결을 적는다(true 또는 CIDR, 예 172.16.0.0/12).
# 비우면 믿지 않고 http 로 본다. 이때 localhost 가 아닌 주소에서는 비밀값 탭이 막히고 로그인 쿠키에 Secure 가 붙지 않는다.
# 프록시가 같은 컴퓨터에 있고 AAS_BIND=127.0.0.1 이면 true 로 둔다(이 컴퓨터 밖에서는 AAS 에 바로 닿지 못한다).
AAS_TRUSTED_PROXY=
# AAS·사이드카 이미지. 기본은 GHCR(ghcr.io/openmaru-io/cogentai-aas-server·-sidecar)의 AAS_VERSION 태그이고, 받을 수 없으면 소스로 빌드한다.
# 폐쇄망이면 사내 레지스트리 주소로 바꾼다.
AAS_VERSION=latest
AAS_IMAGE=
AAS_SIDECAR_IMAGE=
# Hermes 이미지(기본 nousresearch/hermes-agent:v0.22.2). 사용자·그룹 번호는 사이드카가 같은 번호로 읽는다(기본 10000).
HERMES_IMAGE=
HERMES_UID=10000
HERMES_GID=10000
HERMES_DASHBOARD_USER=aas
# AI 보조 호출은 생각 끄기(chat_template_kwargs, vLLM 확장)를 함께 보낸다. LLM 서버가 모르는 인자라며 거절하면 off 로 바꾼다.
AAS_CHAT_TEMPLATE_KWARGS=on
# 스킬 허브(마켓) 설치는 쿠버네티스에서만 된다. compose 는 AAS_MARKET_INSTALL=off, AAS_SKILLHUB_URL 을 비운 채로 띄우고 화면에 이유를 보인다.
# Docmost 위키의 MCP 주소(예: https://wiki.corp.example/mcp, 선택). 적으면 MCP 카탈로그 docmost 항목의 주소 칸이 미리 채워진다. 비워도 사용자가 주소를 넣는다.
AAS_DOCMOST_MCP_URL=
# Outline 위키의 MCP 주소(예: https://wiki.corp.example/mcp, 선택). 적으면 MCP 카탈로그 outline 항목의 주소 칸이 미리 채워지고, 그 주소일 때만 서버가 키를 미리 확인한다.
AAS_OUTLINE_MCP_URL=

# --- 붙기(docker-compose.attach.yml)에서만 --------------------------------
# 이미 돌고 있는 Hermes 의 데이터 폴더(호스트 절대 경로). 사이드카가 읽기 전용으로 붙인다.
HERMES_DATA_DIR=
# 컨테이너 안에서 보이는 그 Hermes 대시보드 주소와 로그인. 호스트의 Hermes 라면 http://host.docker.internal:9119
AAS_DASHBOARD_URL=
AAS_DASHBOARD_USER=
AAS_DASHBOARD_PASSWORD=
# 관리자 이메일(쉼표나 공백으로 여러 명). 비우면 AAS_ADMIN_EMAIL 을 쓴다.
AAS_ADMINS=
# 모델 화면·AI 보조용 LiteLLM 주소(/v1 없이). 위 HERMES_LLM_BASE_URL 이 있으면 그것을 먼저 쓴다. 없어도 나머지는 뜬다
AAS_LITELLM_URL=
# 모델 화면에서 이 앞부분으로 시작하는 모델만 보인다(비우면 모두)
AAS_LITELLM_MODEL_PREFIX=

# --- Hermes 여러 개(docker-compose.multi.yml)에서만 ------------------------
# 이 구성은 HERMES_LLM_* 를 비우면 호스트의 14400 포트(LiteLLM)를 쓴다. AAS_ADMIN_EMAIL 기본은 admin@example.com(pods.multi.json 과 같음).
# 사내 패치 Hermes 이미지로 시험하려면 HERMES_IMAGE 와 그 이미지의 시작 명령을 함께 적는다(README 「Hermes 여러 개」).
HERMES_COMMAND=
