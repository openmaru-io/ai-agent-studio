{
  "realm": "aas",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": false,
  "editUsernameAllowed": false,
  "duplicateEmailsAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": ["ko", "en"],
  "defaultLocale": "ko",
  "bruteForceProtected": true,
  "passwordPolicy": "length(8)",
  "ssoSessionIdleTimeout": 8100,
  "ssoSessionMaxLifespan": 86400,
  "accessTokenLifespan": 3600,
  "offlineSessionIdleTimeout": 2592000,
  "roles": {"realm": [{"name": "aas-admin", "description": "AAS 관리자: 모든 Hermes 를 보고 바꿀 수 있다"}]},
  "groups": [{"name": "aas-users"}, {"name": "aas-admins", "realmRoles": ["aas-admin"]}],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {"providerId": "declarative-user-profile", "subComponents": {}, "config": {"kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"department\",\"displayName\":\"부서\",\"validations\":{\"length\":{\"max\":80}},\"annotations\":{},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"]}}
    ]
  },
  "clients": [
    {
      "clientId": "aas",
      "name": "CogentAI AAS",
      "enabled": true,
      "publicClient": false,
      "secret": "${AAS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["${AAS_PUBLIC_URL}/auth/callback"],
      "webOrigins": ["${AAS_PUBLIC_URL}"],
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "${AAS_PUBLIC_URL}/*"},
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "false"}
        },
        {
          "name": "department",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {"user.attribute": "department", "claim.name": "department", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true", "multivalued": "false"}
        }
      ]
    },
    {
      "clientId": "aas-admin",
      "name": "AAS 서버 서비스 계정(사용자 관리·하루 1회 대조·본인 비밀번호 확인)",
      "enabled": true,
      "publicClient": false,
      "secret": "${AAS_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "service-account-aas-admin",
      "enabled": true,
      "serviceAccountClientId": "aas-admin",
      "clientRoles": {"realm-management": ["view-users", "query-users", "query-groups", "view-realm", "manage-users"]}
    }
  ]
}
